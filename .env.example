# Browser-facing local service endpoints
VITE_KNOWLEDGE_API=http://127.0.0.1:8000
VITE_GENERATION_API=http://127.0.0.1:8788

# Knowledge service
LKS_DATA_DIR=services/knowledge/data
# Use the platform path separator: ':' on macOS/Linux, ';' on Windows.
LKS_ALLOWED_ROOTS=content/demo-knowledge-base
LKS_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# OpenAI-compatible language model used by local agents and prompt planning
DEEPSEEK_BASE_URL=https://api.example.com/v1
DEEPSEEK_API_KEY=your-api-key
DEEPSEEK_MODEL=your-model-id

# Image generation provider
T2I_BASE_URL=https://api.example.com/v1
T2I_API_KEY=your-api-key
T2I_MODEL=your-image-model-id
T2I_ENDPOINT=/images/generations
T2I_RESOLUTION=2k
T2I_POLL_INTERVAL_MS=3000
T2I_MAX_POLL_MS=120000

# Image-to-3D provider
LUX3D_BASE_URL=https://api.example.com/v1
LUX3D_API_KEY=your-api-key
LUX3D_VERSION=G1
LUX3D_FACE_COUNT=200000
LUX3D_POLL_INTERVAL_MS=12000

# Local service binding and browser origins
GEN_PROXY_HOST=127.0.0.1
GEN_PROXY_PORT=8788
GEN_PROXY_MAX_REQUEST_BYTES=1048576
GEN_PROXY_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
AGENT_HOST=127.0.0.1
AGENT_PORT=8790
AGENT_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
COLLAB_HOST=127.0.0.1
COLLAB_PORT=8787
COLLAB_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
